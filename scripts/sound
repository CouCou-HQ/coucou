#!/usr/bin/env bash
# Encode audio into sounds coucou can play: Ogg Opus, snake_case names, optionally rare.
set -euo pipefail

usage() {
	cat <<'EOF'
usage: scripts/sound [-r] [-f] [-n] [-o DIR] FILE|FOLDER...

Encodes each audio file into DIR as Ogg Opus (64k, 48 kHz, stereo), named in snake_case:
"Wet Fart 3.mp3" becomes wet_fart_3.ogg. A folder is searched recursively for audio files.

  -r, --rare       name the output <name>.rare.ogg: a tenth as often, never by /play
  -o, --out DIR    where to write (default: profile/sounds, the checkout's profile)
  -f, --force      overwrite an existing output instead of skipping it
  -n, --dry-run    print what would be written, encode nothing
  -h, --help       this text

A source already named <name>.rare.<ext> stays rare without -r.
EOF
}

rare=0 force=0 dry=0 out="profile/sounds"
inputs=()
while (($#)); do
	case $1 in
	-r | --rare) rare=1 ;;
	-f | --force) force=1 ;;
	-n | --dry-run) dry=1 ;;
	-o | --out)
		[[ $# -ge 2 ]] || { echo "sound: $1 needs a directory" >&2; exit 2; }
		out=$2
		shift
		;;
	-h | --help) usage; exit 0 ;;
	--) shift; inputs+=("$@"); break ;;
	-*) echo "sound: unknown option $1" >&2; usage >&2; exit 2 ;;
	*) inputs+=("$1") ;;
	esac
	shift
done
((${#inputs[@]})) || { usage >&2; exit 2; }
((dry)) || command -v ffmpeg >/dev/null || { echo "sound: ffmpeg is not installed" >&2; exit 1; }

# snake turns a file name into a sound name: lowercase, every run of other characters one underscore.
snake() {
	printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//'
}

# Portable on purpose: macOS ships bash 3.2 and BSD find, so no -regextype, no associative arrays.
audio_find=()
for e in mp3 wav flac m4a aac ogg oga opus wma aif aiff webm mp4 mkv mov; do
	audio_find+=(${audio_find[@]:+-o} -iname "*.$e")
done

files=()
for in in "${inputs[@]}"; do
	if [[ -d $in ]]; then
		while IFS= read -r -d '' f; do files+=("$f"); done < <(
			find "$in" -type f \( "${audio_find[@]}" \) -print0 | sort -z
		)
	elif [[ -f $in ]]; then
		files+=("$in")
	else
		echo "sound: no such file or folder: $in" >&2
		exit 1
	fi
done
((${#files[@]})) || { echo "sound: no audio files found" >&2; exit 1; }

((dry)) || mkdir -p "$out"
done_n=0 skip_n=0 fail_n=0
seen=$'\n'
for f in "${files[@]}"; do
	base=$(basename "$f")
	base=${base%.*}
	tier=""
	if [[ $(printf '%s' "$base" | tr '[:upper:]' '[:lower:]') == *.rare ]]; then
		base=${base%.*}
		tier=.rare
	fi
	((rare)) && tier=.rare
	name=$(snake "$base")
	if [[ -z $name ]]; then
		echo "skip  $f (no letters or digits left to name it by)" >&2
		skip_n=$((skip_n + 1))
		continue
	fi
	dst="$out/$name$tier.ogg"
	if [[ $seen == *$'\n'"$dst"$'\n'* ]]; then
		echo "skip  $f (another input already becomes $dst)" >&2
		skip_n=$((skip_n + 1))
		continue
	fi
	seen+="$dst"$'\n'
	if [[ -e $dst ]] && ((!force)); then
		echo "skip  $f -> $dst (exists; -f to overwrite)"
		skip_n=$((skip_n + 1))
		continue
	fi
	if ((dry)); then
		echo "would $f -> $dst"
		continue
	fi
	# Written beside the target and renamed into place, so the bot never sees a half-written file
	# and a source that is its own target is read whole before it is replaced.
	tmp="$out/.$name$tier.ogg.tmp"
	if ffmpeg -nostdin -loglevel error -y -i "$f" -vn -map_metadata -1 \
		-c:a libopus -b:a 64k -ar 48000 -ac 2 -f ogg "$tmp"; then
		mv -f -- "$tmp" "$dst"
		echo "ok    $f -> $dst"
		done_n=$((done_n + 1))
	else
		rm -f -- "$tmp"
		echo "fail  $f" >&2
		fail_n=$((fail_n + 1))
	fi
done

((dry)) || echo "$done_n encoded, $skip_n skipped, $fail_n failed"
((fail_n == 0))
