.devcontainer/
.vscode/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
config.toml
profile/
deployment/compose/config.toml

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
docs/
CODEOWNERS

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

