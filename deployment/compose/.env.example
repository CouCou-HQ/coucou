# Copy to .env next to compose.yaml. Compose reads it automatically. Bot settings are in
# config.toml (from config.example.toml); this file holds secrets and compose-level knobs.

# Required. From the Discord developer portal, Bot -> Token.
DISCORD_BOT_TOKEN=

# Required. Anything; it never leaves the compose network.
POSTGRES_PASSWORD=

# Optional.
POSTGRES_USER=coucou
POSTGRES_DB=coucou

# Host directory of the bot's profile: profile.toml and sounds/ of pre-encoded Ogg Opus files.
# Relative to this file or absolute. Start one from profile.example.toml at the repo root.
PROFILE_DIR=../../profile

# A published image instead of a local build — note there is no leading v on image tags:
#   COUCOU_IMAGE=ghcr.io/be-sandaa/coucou:0.5.0
# Leave the default and use `docker compose up --build` to compile from this checkout.
COUCOU_IMAGE=coucou:dev
HTTP_PORT=9090
