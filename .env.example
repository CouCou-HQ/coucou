# Every setting below is also a CLI flag, named after the variable in kebab-case
# (DATABASE_URL -> -database-url). A flag wins when given; this file is the fallback.
# Run `coucou -h` for the full list.

DATABASE_URL=postgres://coucou:CHANGE-ME@bots-pg:5432/coucou
#   postgres://user:pass@bots-pg:5432/coucou   -> PostgreSQL (pgx)
#   sqlite:///data/coucou.db  or  file:coucou.db -> embedded SQLite (pure Go, WAL)

DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD=          # only read by a `go build -tags dev` binary, which registers its commands there; see README
OWNER_IDS=                  # comma-separated; unlocks the servers leaderboard

SOUNDS_DIR=/sounds
SOUNDS_POLL=0s              # e.g. 15s on NFS/SMB mounts where inotify doesn't fire
DEFAULT_CHANCE=5            # seeded into guild_settings for guilds with no row yet.
                            # Percent per 5-minute tick, rolled only when someone is in
                            # voice: ~1 visit per 1.5-2h of active voice. 0 = opt-in.

GOMEMLIMIT=48MiB            # soft cap; GC works harder near it instead of letting heap drift
GOGC=50

LOG_LEVEL=info              # debug | info | warn | error. Audit records are stored regardless.
SHARD_COUNT=0               # 0 lets Discord decide. Raise it only to exercise multiple shards.
