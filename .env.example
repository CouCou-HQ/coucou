# Environment for a local run (VS Code's launch configs load .env). Settings live in config.toml;
# this only holds what config.toml references as ${VAR}, plus Go runtime knobs.

DISCORD_BOT_TOKEN=
DATABASE_URL=sqlite://coucou.db
DISCORD_DEV_GUILD=          # only read by a `go build -tags dev` binary, which registers its commands there; see README

GOMEMLIMIT=48MiB            # soft cap; GC works harder near it instead of letting heap drift
GOGC=50
