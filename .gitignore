# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# ── Go binaries ───────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# ── Build output ──────────────────────────────────────────────────────────────
bin/
dist/

# ── Test & coverage artifacts ─────────────────────────────────────────────────
*.out
coverage.*
*.coverprofile
profile.cov

# ── Profiling & benchmarks ────────────────────────────────────────────────────
*.prof
*.bench
trace.out

# ── Debug ─────────────────────────────────────────────────────────────────────
__debug_bin*

# ── Go workspace ──────────────────────────────────────────────────────────────
# Dependency directories (remove the comment below to include it)
# vendor/
go.work
go.work.sum

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
/config.toml
/profile/
/profiles/
/deployment/compose/config.toml

# ── Local dev tooling ─────────────────────────────────────────────────────────
tmp/

# generated mocks (remove this line to track them in version control)
mocks/

# local docker-compose overrides
docker-compose.override.yml

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.idea/
# .vscode/  — intentionally tracked; ships Go/gopls settings for new contributors

# vim/emacs swap and backup files
*.swp
*.swo
*~

# ── AI tools ──────────────────────────────────────────────────────────────────
# GSD planning artifacts
.planning/
# Claude Code local overrides and worktrees (settings.json is fine to commit)
.claude/settings.local.json
.claude/worktrees/
# Aider chat history and session files
.aider*
# Cursor AI
.cursor/
# Continue dev
.continue/
# Sourcegraph Cody
.cody/
